{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "*.test.ts",
    "src-tauri/**/*.test.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": [
    "dist",
    "target",
    "src-tauri/target",
    "node_modules",
    "learning",
    "lib"
  ]
}
